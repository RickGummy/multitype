# Copy to .env and fill in for local development. .env is gitignored.

# Random 32+ char string used to sign JWTs.
# If unset, the server generates a fresh random one at startup (existing tokens die on restart).
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# Postgres connection string. If unset, defaults to:
#   postgres://postgres:postgres@localhost:5432/multitype?sslmode=disable
# If the DB is unreachable, the server still runs but auth + race history are disabled.
DATABASE_URL=

# Comma-separated list of origins allowed to call the API and open WebSockets.
# Leave unset for local dev (any origin works). In production set to your real
# frontend origins, e.g.:
#   ALLOWED_ORIGINS=https://multitype.pages.dev,https://multitype.example.com
ALLOWED_ORIGINS=

# Set to 1 only when the server runs behind a proxy/load balancer that you trust
# to sanitize the X-Forwarded-For header (Render, Cloudflare, Fly, etc.). When
# set, rate limiting uses the real client IP from XFF. When unset, we use the
# direct connection IP so a remote attacker can't forge their identity with a
# self-supplied XFF header and bypass the limiter.
TRUST_PROXY_HEADERS=
