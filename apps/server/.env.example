# Copy to .env and fill in for local development. .env is gitignored.

# Random 32+ char string used to sign JWTs.
# If unset, the server generates a fresh random one at startup (existing tokens die on restart).
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# Postgres connection string. If unset, defaults to:
#   postgres://postgres:postgres@localhost:5432/multitype?sslmode=disable
# If the DB is unreachable, the server still runs but auth + race history are disabled.
DATABASE_URL=
