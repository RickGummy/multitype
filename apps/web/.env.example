# Copy to .env.local for local overrides (gitignored), or set these in the
# host's dashboard (Cloudflare Pages / Vercel / Netlify) for production builds.
# Vite only exposes vars prefixed with VITE_ to the client bundle.

# HTTP base URL of the Go server. No trailing slash.
# Local default: http://localhost:8080
VITE_API_BASE=https://your-server.onrender.com

# WebSocket URL of the Go server.
# Use wss:// (not ws://) in production -- browsers will refuse a ws:// connection
# from an https:// page.
# Local default: ws://127.0.0.1:8080/ws
VITE_WS_URL=wss://your-server.onrender.com/ws
